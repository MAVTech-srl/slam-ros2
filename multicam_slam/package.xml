<?xml version="1.0"?>
<package format="3">
  <name>multistereo_planning_cloud</name>
  <version>0.0.1</version>
  <description>Multi-stereo planning pointcloud component node (up to 8 cams / 4 stereo pairs).</description>

  <maintainer email="simo.godio@gmail.com">Your Name</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core -->
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>

  <!-- OpenCV bridge -->
  <depend>cv_bridge</depend>

  <!-- Eigen is found via CMake; keep this for ROS packaging -->
  <depend>eigen3_cmake_module</depend>

  <!-- Launch files -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <depend>class_loader</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rclcpp_components/>
  </export>
</package>

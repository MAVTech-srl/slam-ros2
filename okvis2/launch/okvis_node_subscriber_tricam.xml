<launch>
    <arg name="rpg" default="false" />
    <arg name="rgb" default="false" />
    <arg name="config_filename" default="" />
    <arg name="path" default=""/>
    <arg name="rviz" default="true"/>
    <arg name="mesh" default="realsense.dae"/>

    <!-- enable simulated time (rosbag /clock) -->
    <arg name="use_sim_time" default="true"/>

    <!-- Optional: make remap targets configurable -->
    <arg name="cam0_topic" default="/uav31/d455/infra1/image_rect_raw"/>
    <arg name="cam1_topic" default="/uav31/d455/infra2/image_rect_raw"/>
    <arg name="cam2_topic" default="/uav31/d435/infra1/image_rect_raw"/>
    <arg name="imu_topic"  default="/uav31/d455/imu"/>

    <node pkg="okvis" exec="okvis_node_subscriber" name="okvis" namespace="okvis">
        <!-- use sim time -->
        <param name="use_sim_time" value="$(var use_sim_time)"/>

        <!-- Remaps for subscriptions -->
        <remap from="cam0/image_raw" to="$(var cam0_topic)"/>
        <remap from="cam1/image_raw" to="$(var cam1_topic)"/>
        <remap from="cam2/image_raw" to="$(var cam2_topic)"/>
        <remap from="imu0"          to="$(var imu_topic)"/>

        <param name="config_filename" value="$(var config_filename)"/>
        <param name="path" value="$(var path)"/>
        <param name="mesh_file" value="file://$(find-pkg-share okvis)/resources/meshes/$(var mesh)"/>
    </node>

    <node pkg="rviz2" exec="rviz2" name="rviz2" namespace="okvis"
          args="-d $(find-pkg-share okvis)/config/rviz2/rviz2_config.rviz" if="$(var rviz)">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
    </node>
</launch>
